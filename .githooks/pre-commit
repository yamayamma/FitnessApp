#!/bin/bash

# Pre-commit hook for SwiftFormat
# This hook runs SwiftFormat on staged Swift files before committing

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Check if swiftformat is installed
if ! command -v swiftformat &> /dev/null; then
    echo -e "${YELLOW}⚠️  SwiftFormat is not installed. Install it with: brew install swiftformat${NC}"
    echo -e "${YELLOW}Skipping format check...${NC}"
    exit 0
fi

# Get list of staged Swift files
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.swift$")

if [ -z "$STAGED_SWIFT_FILES" ]; then
    echo -e "${GREEN}✅ No Swift files to check${NC}"
    exit 0
fi

echo "📝 Checking Swift files formatting..."

# Run SwiftFormat on staged files
SWIFTFORMAT_OUTPUT=$(swiftformat --lint $STAGED_SWIFT_FILES 2>&1)
SWIFTFORMAT_EXIT_CODE=$?

if [ $SWIFTFORMAT_EXIT_CODE -ne 0 ]; then
    echo -e "${RED}❌ SwiftFormat found formatting issues:${NC}"
    echo "$SWIFTFORMAT_OUTPUT"
    echo ""
    echo -e "${YELLOW}💡 Fix formatting with: swiftformat .${NC}"
    echo -e "${YELLOW}Then stage your changes and commit again${NC}"
    exit 1
fi

echo -e "${GREEN}✅ All Swift files are properly formatted${NC}"

# Optional: Run SwiftLint if installed
if command -v swiftlint &> /dev/null; then
    echo "🔍 Running SwiftLint..."
    
    # Create temp file list with secure permissions
    TEMP_FILE=$(mktemp -t swiftlint_files.XXXXXX)
    echo "$STAGED_SWIFT_FILES" > "$TEMP_FILE"
    
    # Run SwiftLint on staged files
    swiftlint lint --use-script-input-files --force-exclude < "$TEMP_FILE"
    SWIFTLINT_EXIT_CODE=$?
    
    rm "$TEMP_FILE"
    
    if [ $SWIFTLINT_EXIT_CODE -ne 0 ]; then
        echo -e "${RED}❌ SwiftLint found issues${NC}"
        echo -e "${YELLOW}💡 Fix issues and commit again${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✅ SwiftLint checks passed${NC}"
fi

echo -e "${GREEN}🎉 All pre-commit checks passed!${NC}"
exit 0
